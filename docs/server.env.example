# Beispielwerte; nicht als .env verwenden, bevor alle Werte geprüft wurden.
APP_ENV=local
KAPA_MODE=server
APP_HOST=0.0.0.0
APP_PORT=8002
APP_THREADS=8
APP_SECRET_KEY=CHANGE_ME
KAPA_SERVER_TRANSPORT=http-internal
KAPA_TRUSTED_HOSTS=viepaps122.ptg.local,localhost,127.0.0.1
TRUSTED_PROXY_HOPS=0
PLATFORM_AUTH_MODE=off
MONGODB_URI=CHANGE_ME
MONGODB_DATABASE=CHANGE_ME
KAPA_COLLECTION_PREFIX=kapa_prod_
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
