# Copy to .env and fill in real values. Placeholders only - never commit real secrets (SEC-04).
# Standard variable names: gma-app-standards/standards/02-app-structure.md (STR-06)

APP_ENV=local                      # local | dev | prd
APP_HOST=127.0.0.1                 # always loopback behind the app proxy (PRX-01)
APP_PORT=5123              # = [runtime].default_port in app.manifest.toml (REG-05)
APP_THREADS=8
APP_SECRET_KEY=CHANGE_ME           # required for prd: python -c "import secrets; print(secrets.token_hex(32))"
TRUSTED_PROXY_HOPS=1               # 0 only if Waitress is reachable without the proxy in front

MONGODB_URI=mongodb://<db_username>:<db_password>@<host>:27017/gma-kapa-planung-q?authSource=gma-kapa-planung-q
MONGODB_DATABASE=gma-kapa-planung-q
CORE_MONGODB_DATABASE=gma-operationsplatform-q   # -prod on prd; read-only for modules (MD-01)
MONGODB_TIMEOUT_MS=5000

MONITORING_TOKEN=                  # when set, /health/metrics requires header X-Monitoring-Token
PLATFORM_AUTH_MODE=off             # "shared" on dev/prd: the portal login protects the module (chapter 10)

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
